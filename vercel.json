{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_matrix/:path*",
      "destination": "https://matrix.llc.qzz.io/_matrix/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://matrix.llc.qzz.io/.well-known/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://matrix.llc.qzz.io/healthz"
    },
    {
      "source": "/((?!_matrix|\\.well-known|healthz).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(assets/:path*|canvaskit/:path*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(main\\.dart\\.js|index\\.html|config\\.json|flutter_service_worker\\.js|manifest\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
